{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prospectwatch.com/schemas/enrichment-observation.schema.json",
  "title": "Prospect Watch Enrichment Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "field",
    "value",
    "source_id",
    "source_url",
    "source_category",
    "observed_at",
    "extraction_method",
    "confidence",
    "status"
  ],
  "properties": {
    "version": { "type": "string" },
    "athlete_id": { "type": ["string", "null"] },
    "discovery_candidate_id": { "type": ["string", "null"] },
    "field": {
      "type": "string",
      "enum": [
        "first_name",
        "last_name",
        "sport",
        "gender",
        "grad_year",
        "position",
        "secondary_position",
        "high_school",
        "club_team",
        "city",
        "state_province",
        "country",
        "height",
        "jersey_number",
        "commitment_status",
        "committed_school",
        "national_rank",
        "state_rank",
        "instagram_handle",
        "profile_photo_url",
        "action_photo_url",
        "award",
        "stat_line",
        "roster_presence"
      ]
    },
    "value": {},
    "source_id": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "source_category": {
      "type": "string",
      "enum": [
        "official_school",
        "official_college",
        "governing_body",
        "club",
        "event",
        "editorial",
        "athlete_public_profile",
        "manual"
      ]
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "extraction_method": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": {
      "type": "string",
      "enum": ["pending", "accepted", "rejected", "superseded", "conflict"]
    },
    "raw": {}
  },
  "anyOf": [
    { "required": ["athlete_id"] },
    { "required": ["discovery_candidate_id"] }
  ]
}
